__pycache__/
*.py[cod]
.venv/
# data/* rather than data/, because git cannot re-include anything inside a
# directory it has been told to ignore wholesale - and traces are meant to be
# pushed. That is the entire point of writing them.
data/*
!data/logs/
data/logs/*
!data/logs/*.jsonl
!data/logs/*.md
data/logs/lomas.jsonl

config/site.yaml
config/secrets.env
*.env
!*.env.example
.pytest_cache/

# Models are committed so that a clone runs. Two exceptions, both about size:
# a piper voice is 60-100 MB and a face-recognition model is tens of MB, and
# git keeps every version of a binary forever.
models/piper/
models/vosk/
models/wake/
models/face_recognition_*.onnx
models/**/*.part
