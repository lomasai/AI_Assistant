# Server
HOST=0.0.0.0
PORT=8000
ADMIN_API_TOKEN=

# LLM Providers
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
XAI_API_KEY=your_xai_api_key
GENERIC_OPENAI_COMPATIBLE_API_KEY=

# Provider selection belongs in config/default.yaml or config/device.yaml:
# llm.active_provider: mock | openai | groq | deepseek | xai | generic_openai_compatible
# API keys stay here and are loaded by the configured api_key_env name.

# Speech-to-text
# placeholder returns deterministic text for development.
# groq_whisper uses GROQ_API_KEY and Groq's Whisper endpoint.
# whisper_api requires WHISPER_API_KEY.
STT_PROVIDER=placeholder
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_API_KEY=
WHISPER_API_MODEL=whisper-1
STT_LANGUAGE=en

# Memory
FAISS_INDEX_PATH=./memory/faiss.index
MEMORY_LOG_DB=./memory/logs.db

# Local biometric/profile persistence
# The SQLite path is configured in config/default.yaml or config/device.yaml.
# Do not put API keys or temporary camera frames in SQLite.

# Phase 5 voice configuration lives in YAML:
# audio, wake_word, vad, stt, tts and feature_flags.
# External STT/TTS providers should be documented before use because they can send audio/text off-device.

# Phase 6 engagement configuration lives in YAML:
# engagement and feature_flags.engagement_analysis.
# The server only uses observable cues and must not log raw images, model paths,
# biometric embeddings, medical data or psychological labels.

# Phase 7A hardware configuration lives in YAML:
# hardware and feature_flags.hardware_control.
# Physical output is disabled by default. Do not enable physical output until
# the exact ESP32 board, driver board, power system, mechanical limits and
# emergency-stop method are documented and approved.

# Routing
DEFAULT_MODEL=groq
COMPLEXITY_THRESHOLD=3

# Edge/Server communication
EDGE_BASE_URL=http://127.0.0.1:8000
WS_PATH=/ws

# Pipeline optimization
PIPELINE_CACHE_ENABLED=true
PIPELINE_CACHE_MAX_ITEMS=256
PIPELINE_STT_CACHE_TTL_SECONDS=300
PIPELINE_DECISION_CACHE_TTL_SECONDS=180
PIPELINE_TTS_CACHE_TTL_SECONDS=900
PIPELINE_TTS_FAIL_HARD=false
