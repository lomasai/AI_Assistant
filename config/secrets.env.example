# Your machine, in one file.
#
#     cp config/secrets.env.example config/secrets.env
#
# Two kinds of line live here, and they are treated differently.
#
#   KEYS       an API key. Never printed, never reaches the config tree, so
#              it cannot appear in --show-config or on /api/debug/config.
#   SETTINGS   LOMAS__ followed by the config path, double underscore between
#              each level. These do become config, and they are logged by
#              name because a model name is not a secret.
#
# config/secrets.env is gitignored. An already-exported environment variable
# always wins, so a real deployment can inject secrets properly and still
# keep this file for the bench.


# ============================================================ API keys =====

# Groq and OpenAI need nothing installed - both are plain HTTP.
GROQ_API_KEY=

# Anthropic also needs: pip install anthropic
ANTHROPIC_API_KEY=

OPENAI_API_KEY=

# Only for the porcupine wake word.
PICOVOICE_ACCESS_KEY=


# ====================================================== which AI to use =====
# Anything in config/default.yaml can be set here. The rule is
# LOMAS__ + the path, with __ between levels:
#
#     llm.provider           ->  LOMAS__llm__provider
#     speech.tts.engine      ->  LOMAS__speech__tts__engine
#     face.detect_fps        ->  LOMAS__face__detect_fps

# offline | groq | anthropic | openai
#LOMAS__llm__provider=groq

# When the connection drops mid-lesson. Leave this on offline.
#LOMAS__llm__fallback_provider=offline

# The model, for whichever provider is selected above. Empty uses the
# endpoint default below.
#LOMAS__llm__model=llama-3.3-70b-versatile

# Per-provider defaults, used when llm.model is empty.
#LOMAS__llm__endpoints__groq__model=llama-3.3-70b-versatile
#LOMAS__llm__endpoints__anthropic__model=claude-opus-5
#LOMAS__llm__endpoints__openai__model=gpt-4o-mini

# The router scores each question and picks one model - never a chain.
#LOMAS__llm__router__enabled=true
#LOMAS__llm__router__simple_provider=groq
#LOMAS__llm__router__medium_provider=groq
#LOMAS__llm__router__complex_provider=anthropic


# ============================================================== speech =====

# piper (local, needs the binary and a voice) | gtts (cloud) | null (silent)
#LOMAS__speech__tts__engine=piper
#LOMAS__speech__tts__voice__en=en_US-lessac-medium
#LOMAS__speech__tts__voice__hi=hi_IN-pratham-medium

# An Indian voice. piper has Hindi and Marathi voices but no Indian English
# one, so for English with an accent a class here will recognise, use gtts:
#   LOMAS__speech__tts__engine=gtts
#   LOMAS__speech__tts__accent=co.in
# It needs internet. For Hindi, piper is local and better:
#   LOMAS__content__language=hi
#   LOMAS__speech__tts__engine=piper

# auto | none | winsound | aplay | afplay | ffplay | mpg123
#LOMAS__speech__tts__player=auto

# groq | vosk | keyboard
#LOMAS__speech__stt__engine=keyboard


# =============================================== camera and recognition =====

# yunet needs models/face_detection_yunet_2023mar.onnx
#LOMAS__face__detector=yunet
#LOMAS__face__detect_fps=8

# arcface_onnx needs onnxruntime and a face model; mock needs neither.
#LOMAS__face__embedder=mock

# false makes the robot address the room instead of a child, and everything
# else still works.
#LOMAS__privacy__recognition_enabled=true


# =============================================================== lesson =====

#LOMAS__content__language=en
#LOMAS__content__grade=6
#LOMAS__content__subject=science
#LOMAS__content__default_topic=photosynthesis

# false waits for the teacher to press Start; true teaches one class and exits
#LOMAS__flow__autostart=false


# =============================================================== server =====

#LOMAS__web__port=8080
#LOMAS__hardware__enabled=true
#LOMAS__hardware__backend=simulator
